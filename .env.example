# Required for the API and Drizzle
DATABASE_URL=postgres://user:pass@host:5432/onlyfavors
PORT=5000
NODE_ENV=development

# Session hashing — required in production (16+ chars)
AUTH_PEPPER=

# First admin: this email receives the admin role on first successful OTP
ADMIN_BOOTSTRAP_EMAIL=

# Email delivery for 8-digit OTP. Without this, production sign-in fails closed.
RESEND_API_KEY=
AUTH_FROM_EMAIL=OnlyFavors <noreply@onlyfavors.app>

# Optional direct Stripe (otherwise Replit Stripe connector is used)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional direct Supabase REST (otherwise Replit Supabase connector is used)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 64 hex chars (32 bytes) or a raw 32-character secret. Server-only; never sent to the browser.
LOCATION_ENCRYPTION_KEY=
